{
  "name": "sap-abap-ai-mcp",
  "version": "1.0.0",
  "description": "Guides on connecting AI Agents via ABAP MCP to live SAP systems, featuring practical ABAP utilities coded with AI to assist SAP Basis operations.",
  "main": "scripts/deploy.js",
  "scripts": {
    "deploy": "node scripts/deploy.js",
    "deploy:role:01": "node scripts/deploy.js src/z_role_01_create_master.prog.abap Z_ROLE_01_CREATE_MASTER",
    "deploy:role:02": "node scripts/deploy.js src/z_role_02_create_derive.prog.abap Z_ROLE_02_CREATE_DERIVE",
    "deploy:role:03": "npm run deploy:role:03a && npm run deploy:role:03b && npm run deploy:role:03c",
    "deploy:role:03a": "node scripts/deploy.js src/z_role_03a_update_org.prog.abap Z_ROLE_03A_UPDATE_ORG",
    "deploy:role:03b": "node scripts/deploy.js src/z_role_03b_update_object.prog.abap Z_ROLE_03B_UPDATE_OBJECT",
    "deploy:role:03c": "node scripts/deploy.js src/z_role_03c_update_activity.prog.abap Z_ROLE_03C_UPDATE_ACTIVITY",
    "deploy:role:04": "node scripts/deploy.js src/z_role_04_create_composite.prog.abap Z_ROLE_04_CREATE_COMPOSITE",
    "deploy:role:all": "npm run deploy:role:01 && npm run deploy:role:02 && npm run deploy:role:03 && npm run deploy:role:04",
    "deploy:user:01": "node scripts/deploy.js src/z_user_01_create.prog.abap Z_USER_01_CREATE",
    "deploy:user:02": "node scripts/deploy.js src/z_user_02_assign_role.prog.abap Z_USER_02_ASSIGN_ROLE",
    "deploy:user:03": "node scripts/deploy.js src/z_user_03_sspr_admin.prog.abap Z_USER_03_SSPR_ADMIN",
    "deploy:class:sspr": "node scripts/deploy_class.js ZCL_SSPR_HTTP_HANDLER",
    "deploy:user:all": "npm run deploy:user:01 && npm run deploy:user:02 && npm run deploy:user:03 && npm run deploy:class:sspr",
    "deploy:su53": "node scripts/deploy.js src/z_auth_su53_analyzer.prog.abap Z_AUTH_SU53_ANALYZER",
    "deploy:export:obj": "node scripts/deploy.js src/z_export_obj_levels.prog.abap Z_EXPORT_OBJ_LEVELS",
    "deploy:all": "npm run deploy:role:all && npm run deploy:user:all && npm run deploy:su53 && npm run deploy:export:obj",
    "convert:role": "python scripts/convert_role.py",
    "convert:role:01": "python scripts/convert_role_01_master.py",
    "convert:role:02": "python scripts/convert_role_02_derive.py",
    "convert:role:03": "python scripts/convert_role_03_org_obj.py",
    "convert:role:04": "python scripts/convert_role_04_composite.py",
    "convert:role:all": "python scripts/convert_role.py",
    "convert:user": "python scripts/convert_user.py",
    "convert:user:01": "python scripts/convert_user_01_create.py",
    "convert:user:02": "python scripts/convert_user_02_assign.py",
    "convert:user:all": "python scripts/convert_user.py",
    "convert:user:matrix": "python scripts/convert_user_matrix.py",
    "convert:user:matrix:01": "python scripts/convert_user_matrix_01_create.py",
    "convert:user:matrix:02": "python scripts/convert_user_matrix_02_assign.py",
    "convert:all": "npm run convert:role:all && npm run convert:user",
    "templates:generate": "python scripts/create_templates.py",
    "docs:pdf": "python scripts/generate_user_guide_pdf.py",
    "check:sanitization": "python scripts/check_sanitization.py"
  },
  "keywords": [
    "sap",
    "abap",
    "mcp",
    "model-context-protocol",
    "sap-basis",
    "ai-agents",
    "adt",
    "grok-build",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luongdk18/SAPABAP.git"
  },
  "homepage": "https://github.com/luongdk18/SAPABAP#readme",
  "author": "Luong Doan <luongdkvn@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@mcp-abap-adt/core": "^23.1.0"
  }
}
