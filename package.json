{
  "name": "sap-abap-ai-mcp",
  "version": "1.0.0",
  "description": "Guides on connecting AI Agents via ABAP MCP to live SAP systems, featuring practical ABAP utilities coded with AI to assist SAP Basis operations.",
  "main": "scripts/deploy.js",
  "scripts": {
    "deploy": "node scripts/deploy.js",
    "deploy:auth": "node scripts/deploy.js src/z_auth_test.prog.abap Z_AUTH_TEST",
    "deploy:role": "node scripts/deploy.js src/z_auth_role_create.prog.abap Z_AUTH_ROLE_CREATE",
    "deploy:derive": "node scripts/deploy.js src/z_auth_role_derive.prog.abap Z_AUTH_ROLE_DERIVE",
    "deploy:org": "node scripts/deploy.js src/z_auth_role_update_org.prog.abap Z_AUTH_ROLE_UPDATE_ORG",
    "deploy:composite": "node scripts/deploy.js src/z_auth_role_composite.prog.abap Z_AUTH_ROLE_COMPOSITE",
    "deploy:user": "node scripts/deploy.js src/z_auth_user_create.prog.abap Z_AUTH_USER_CREATE",
    "convert:role:master": "python scripts/convert_role_master_excel.py",
    "convert:role:derived": "python scripts/convert_role_derived_excel.py",
    "convert:role:org": "python scripts/convert_role_org_excel.py",
    "convert:role:composite": "python scripts/convert_role_composite_excel.py",
    "convert:role:all": "npm run convert:role:master && npm run convert:role:derived && npm run convert:role:org && npm run convert:role:composite",
    "convert:user:create": "python scripts/convert_users_excel.py"
  },
  "keywords": [
    "sap",
    "abap",
    "mcp",
    "model-context-protocol",
    "sap-basis",
    "ai-agents",
    "adt",
    "grok-build",
    "claude",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/luongdk18/SAPABAP.git"
  },
  "homepage": "https://github.com/luongdk18/SAPABAP#readme",
  "author": "Luong Doan <luongdkvn@gmail.com>",
  "license": "MIT"
}
