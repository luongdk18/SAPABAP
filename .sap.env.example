# SAP ABAP ADT Connection Configuration
# Copy this file to .sap.env and fill in your actual SAP credentials.
# WARNING: NEVER commit .sap.env to Git or public repositories!

# SAP Application Server HTTPS URL (with ADT / ICF port)
SAP_URL=https://your-sap-host.example.com:44300

# SAP Client (Mandant)
SAP_CLIENT=100

# Authentication Type: 'basic' (on-premise user/password) or 'xsuaa' (SAP BTP)
SAP_AUTH_TYPE=basic

# System Type: 'onprem' or 'cloud'
SAP_SYSTEM_TYPE=onprem

# SAP User Credentials (User must have ADT authorizations - S_ADT_RES, S_RFC, etc.)
SAP_USERNAME=YOUR_SAP_USER
SAP_PASSWORD=YOUR_SAP_PASSWORD

# System ID (optional)
SAP_MASTER_SYSTEM=DEV

# Logon Language
SAP_LANGUAGE=EN

# Set to 0 if using self-signed SSL certificates in development/sandbox environments
NODE_TLS_REJECT_UNAUTHORIZED=0

# Target Package for ABAP Programs (Default: $TMP for local sandbox/testing without transport)
# Set to your organization's transportable package (e.g. ZBASIS, ZDEVELOPMENT) if transporting
SAP_PACKAGE=$TMP

# Workbench Transport Request (Required ONLY if SAP_PACKAGE is NOT $TMP)
# Uncomment and set your modifiable Workbench Request if deploying to a transportable package:
# SAP_TRANSPORT_REQUEST=DEVK900001
