{
  "mcpServers": {
    "sap-s4hana": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "mcp-abap-adt-compact",
        "--env-path=C:\\path\\to\\SAPABAP\\.sap.env",
        "--connection-type=http",
        "--deferred-logon",
        "--deny-actions=HandlerDebug*"
      ],
      "env": {
        "HANDLER_LOG_SILENT": "true"
      }
    },
    "sap-s4hana-readonly": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "mcp-abap-adt-compact-ro",
        "--env-path=C:\\path\\to\\SAPABAP\\.sap.env",
        "--connection-type=http",
        "--deferred-logon"
      ],
      "env": {
        "HANDLER_LOG_SILENT": "true"
      }
    }
  }
}
